#!/usr/bin/env bash
# bops-local: an app's Local on this computer (Bops, Your Apps: Local, Staging, Prod). Its working folder
# (/workspace/apps/<app>) run as a dev server on a port of its own, not public: it opens on this screen, or
# from the owner's Mac over the tailnet. Bops runs it (from the Mac, through Orgo's bash), and so can the bot.
#
#   bops-local start <app> <site> [<command, base64, or ->] [<its command when it has none, base64, or ->] [<Staging's project name, or ->]
#   bops-local stop <app> <site>
#   bops-local status [<app>]
#   bops-local open <app> <site>
#   bops-local env <app> <site>     (the changes on stdin: base64 JSON {NAME: "value" | null})
#
# Its variables: Staging's (its live release's app.env, when there is one), then its own (<app>--<site>.env)
# on top. What it keeps is in /root/.bops/local, root's alone: <app>--<site>.conf (port, command, when),
# .env (its own variables, 0600), .run.sh, .log. Every answer is BOPS_LOCAL lines:
#   BOPS_LOCAL <app>--<site> <state> <port> <since> <command, base64> <last words, base64> <its own variables' names, comma separated>
# state: running (its port answers), starting (its process runs, its port doesn't answer yet), failed (it
# stopped by itself), stopped.
set -uo pipefail
umask 077
D=/root/.bops/local
mkdir -p "$D" && chmod 700 "$D"
NAME_RE='^[a-z0-9]+(-[a-z0-9]+)*$'
die() { echo "BOPS_LOCAL_FAIL=$1"; exit 1; }
b64() { printf %s "$1" | base64 -w0; }

# The Local of <app> <site>: its key, in K.
need_key() {
  [[ "${1:-}" =~ $NAME_RE ]] && [[ "${2:-}" =~ $NAME_RE ]] || die "bad-name"
  K="$1--$2"
}

# One Local's conf, read without running it (only the lines Bops writes, each checked).
read_conf() {
  PORT= PID= CMD_B64= SINCE= STOPPED= ENVFROM=
  local f="$D/$1.conf" k v
  [ -f "$f" ] || return 1
  while IFS='=' read -r k v; do
    case "$k" in
      PORT) [[ "$v" =~ ^[0-9]{1,5}$ ]] && PORT=$v ;;
      PID) [[ "$v" =~ ^[0-9]{1,9}$ ]] && PID=$v ;;
      CMD_B64) [[ "$v" =~ ^[A-Za-z0-9+/=]*$ ]] && CMD_B64=$v ;;
      SINCE) [[ "$v" =~ ^[0-9]{1,12}$ ]] && SINCE=$v ;;
      STOPPED) [[ "$v" =~ ^[01]$ ]] && STOPPED=$v ;;
      ENVFROM) [[ "$v" =~ ^[a-z0-9][a-z0-9-]{0,31}$ ]] && ENVFROM=$v ;;
    esac
  done < "$f"
  return 0
}

write_conf() {
  printf 'PORT=%s\nPID=%s\nCMD_B64=%s\nSINCE=%s\nSTOPPED=%s\nENVFROM=%s\n' "$PORT" "$PID" "$CMD_B64" "$SINCE" "$STOPPED" "$ENVFROM" > "$D/$1.conf.new" && mv -f "$D/$1.conf.new" "$D/$1.conf"
}

alive() { [ -n "$1" ] && kill -0 "$1" 2>/dev/null; }
# Something listens on the port (a dev server still compiling its first page counts).
answers() { [ -n "$1" ] && (exec 3<>"/dev/tcp/127.0.0.1/$1") 2>/dev/null; }

env_names() {
  local f="$D/$1.env"
  [ -f "$f" ] || { echo -; return; }
  local names
  names=$(grep -oE '^[A-Z_][A-Z0-9_]*=' "$f" | tr -d = | sort -u | paste -sd, -)
  echo "${names:--}"
}

say() {
  local k=$1 state=stopped err=
  read_conf "$k" || return 0
  if alive "$PID"; then
    if answers "$PORT"; then state=running; else state=starting; fi
  elif [ "$STOPPED" = 0 ]; then
    state=failed
    err=$(tail -n 5 "$D/$k.log" 2>/dev/null | tr -d '\r' | tail -c 600)
  fi
  echo "BOPS_LOCAL $k $state ${PORT:--} ${SINCE:--} ${CMD_B64:--} $( [ -n "$err" ] && b64 "$err" || echo -) $(env_names "$k")"
}

# A port for a Local: the one it had, else the first from 4100 that no other Local has and nothing listens on.
pick_port() {
  local k=$1 p f taken
  if read_conf "$k" && [ -n "$PORT" ]; then echo "$PORT"; return; fi
  taken=" $(for f in "$D"/*.conf; do [ -f "$f" ] && grep -oE '^PORT=[0-9]+' "$f" | cut -d= -f2; done | tr '\n' ' ') "
  for p in $(seq 4100 4199); do
    case "$taken" in *" $p "*) continue ;; esac
    if command -v ss >/dev/null 2>&1 && ss -ltnH 2>/dev/null | awk '{print $4}' | grep -qE "[:.]$p\$"; then continue; fi
    echo "$p"
    return
  done
}

stop_one() {
  local k=$1 n
  read_conf "$k" || return 0
  if alive "$PID"; then
    kill -TERM -- "-$PID" 2>/dev/null || kill -TERM "$PID" 2>/dev/null
    for n in 1 2 3 4 5 6; do alive "$PID" || break; sleep 0.5; done
    alive "$PID" && { kill -KILL -- "-$PID" 2>/dev/null || kill -KILL "$PID" 2>/dev/null; }
  fi
  STOPPED=1
  write_conf "$k"
}

# What its folder says to run, when it wasn't given a command: package.json's dev script, else its start
# script, else a plain site's index.html.
detect() {
  if [ -f package.json ]; then
    local s
    s=$(python3 -c 'import json,sys;s=json.load(open("package.json")).get("scripts") or {};print("dev" if "dev" in s else "start" if "start" in s else "")' 2>/dev/null || true)
    [ "$s" = dev ] && { echo "npm run dev"; return; }
    [ "$s" = start ] && { echo "npm start"; return; }
  fi
  [ -f index.html ] && { echo 'python3 -m http.server "$PORT" --bind 0.0.0.0'; return; }
  echo ""
}

cmd=${1:-}
case "$cmd" in
  start)
    need_key "${2:-}" "${3:-}"
    k=$K
    APP=$2
    DIR=/workspace/apps/$APP
    [ -d "$DIR" ] || die "no-folder"
    GIVEN=${4:--}
    FALLBACK=${5:--}
    FROM=${6:--}
    [ "$GIVEN" = - ] && GIVEN=
    [ "$FALLBACK" = - ] && FALLBACK=
    [ "$FROM" = - ] && FROM=
    [[ "$GIVEN" =~ ^[A-Za-z0-9+/=]*$ ]] && [[ "$FALLBACK" =~ ^[A-Za-z0-9+/=]*$ ]] || die "bad-command"
    [ -z "$FROM" ] || [[ "$FROM" =~ ^[a-z0-9][a-z0-9-]{0,31}$ ]] || die "bad-name"
    stop_one "$k"
    P=$(pick_port "$k")
    [ -n "$P" ] || die "no-port"
    read_conf "$k" || true
    # The command given, else the one it ran last, else the one Bops says (its site's start command), else what its folder says.
    if [ -n "$GIVEN" ]; then CMD=$(printf %s "$GIVEN" | base64 -d)
    elif [ -n "$CMD_B64" ]; then CMD=$(printf %s "$CMD_B64" | base64 -d)
    elif [ -n "$FALLBACK" ]; then CMD=$(printf %s "$FALLBACK" | base64 -d)
    else CMD=$(cd "$DIR" && detect); fi
    [ -n "$CMD" ] || die "no-command"
    NODE_DIR=$(ls -d /opt/orgo/runtimes/node-v*-linux-* 2>/dev/null | sort -V | tail -n 1)
    {
      echo '#!/bin/bash'
      echo '# bops-local: what this Local runs. Bops writes this file.'
      echo 'set -a'
      [ -n "$FROM" ] && printf '[ -r %q ] && . %q\n' "/opt/orgo-apps/$FROM/current/app.env" "/opt/orgo-apps/$FROM/current/app.env"
      printf '[ -r %q ] && . %q\n' "$D/$k.env" "$D/$k.env"
      echo 'set +a'
      printf 'export PORT=%q HOST=0.0.0.0\n' "$P"
      [ -n "$NODE_DIR" ] && printf 'export PATH=%q:"$PATH"\n' "$NODE_DIR/bin"
      printf 'cd %q || exit 1\n' "$DIR"
      echo 'if [ -f package.json ] && [ ! -d node_modules ]; then echo "$ npm install"; npm install || exit 1; fi'
      printf 'echo %q\n' "\$ $CMD"
      printf 'exec /bin/bash -c %q\n' "$CMD"
    } > "$D/$k.run.sh" && chmod 700 "$D/$k.run.sh" || die "write"
    : > "$D/$k.log"
    setsid nohup /bin/bash "$D/$k.run.sh" >> "$D/$k.log" 2>&1 < /dev/null &
    PORT=$P PID=$! CMD_B64=$(b64 "$CMD") SINCE=$(date +%s) STOPPED=0 ENVFROM=$FROM
    write_conf "$k" || die "write"
    for _ in $(seq 1 12); do answers "$P" && break; alive "$PID" || break; sleep 0.5; done
    say "$k"
    ;;
  stop)
    need_key "${2:-}" "${3:-}"
    k=$K
    stop_one "$k"
    say "$k"
    ;;
  status)
    APP=${2:-}
    [ -z "$APP" ] || [[ "$APP" =~ $NAME_RE ]] || die "bad-name"
    for f in "$D"/*.conf; do
      [ -f "$f" ] || continue
      k=$(basename "$f" .conf)
      [ -z "$APP" ] || [[ "$k" == "$APP--"* ]] || continue
      say "$k"
    done
    echo "BOPS_LOCAL_DONE=1"
    ;;
  open)
    need_key "${2:-}" "${3:-}"
    k=$K
    read_conf "$k" && [ -n "$PORT" ] || die "not-started"
    URL="http://localhost:$PORT/"
    if ! curl -sf -X PUT --max-time 3 "http://127.0.0.1:9299/json/new?$URL" > /dev/null 2>&1; then
      command -v bops-chrome > /dev/null 2>&1 || die "no-browser"
      bops-chrome 99 "$URL" > /dev/null 2>&1 || die "no-browser"
    fi
    echo "BOPS_LOCAL_OPENED=1"
    say "$k"
    ;;
  env)
    need_key "${2:-}" "${3:-}"
    k=$K
    # The changes come on stdin (base64 JSON), never on a command line others on the computer could read.
    CHANGES=$(cat)
    [[ "$CHANGES" =~ ^[A-Za-z0-9+/=]+$ ]] || die "bad-env"
    printf %s "$CHANGES" | base64 -d | python3 -c '
import json, re, shlex, sys, os
path = sys.argv[1]
changes = json.load(sys.stdin)
have = {}
if os.path.exists(path):
    for line in open(path):
        m = re.match(r"^([A-Z_][A-Z0-9_]*)=(.*)$", line.rstrip("\n"))
        if m:
            have[m.group(1)] = shlex.split(m.group(2))[0] if m.group(2) else ""
for k, v in changes.items():
    if not re.match(r"^[A-Z_][A-Z0-9_]{0,127}$", k):
        sys.exit(2)
    if v is None:
        have.pop(k, None)
    else:
        have[k] = str(v)
tmp = path + ".new"
with open(os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w") as f:
    for k in sorted(have):
        f.write(k + "=" + shlex.quote(have[k]) + "\n")
os.replace(tmp, path)
' "$D/$k.env" || die "bad-env"
    echo "BOPS_LOCAL_ENV=$(env_names "$k")"
    ;;
  *)
    die "usage"
    ;;
esac
